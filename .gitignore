# Large or local-only files. The CAD's source STEP files are too big for GitHub (the RCC's is 101 MB) and are not needed to
# regenerate a guide (the converted .glb files are kept); their checksums are in cad-sources.sha256.
*.STEP
*.step
*.stp
*.sldprt
*.sldasm
*.SLDPRT
*.SLDASM
*.igs
*.iges
*.x_t
*.x_b
*.f3d
*.stl
*.3mf
*.dxf
MRA_Videos/
share/
thumbs/
!docs/research/**/thumbs/
.venv.nosync/
__pycache__/
*.pyc
.DS_Store
.claude/settings.local.json
# The repository's own data lives in .git.nosync (kept out of iCloud sync); .git is a pointer file to it.
.git.nosync/
# publish.py's lock and unfinished copies
releases/.lock
site/.*
releases/*/.*.tmp/
